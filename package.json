{
  "name": "dev-tools",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --mode web",
    "dev:chrome": "vite --mode chrome",
    "build": "npm run build:web",
    "build:web": "tsc && vite build --mode web",
    "build:chrome": "tsc && vite build --mode chrome",
    "preview": "vite preview",
    "lint": "eslint src vite.config.ts --report-unused-disable-directives --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@monaco-editor/react": "4.7.0",
    "diff": "^5.2.2",
    "dompurify": "^3.4.17",
    "highlight.js": "^11.12.0",
    "jsonc-parser": "^3.3.1",
    "katex": "0.18.10",
    "lottie-web": "^5.13.0",
    "marked": "^16.4.2",
    "marked-katex-extension": "^5.1.13",
    "mermaid": "^11.17.2",
    "monaco-editor": "0.57.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/diff": "^5.0.8",
    "@types/node": "^24.13.6",
    "@types/react": "^18.2.43",
    "@types/react-dom": "^18.2.17",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^17.13.0",
    "jsdom": "^29.1.1",
    "typescript": "^5.2.2",
    "typescript-eslint": "^8.71.2",
    "vite": "^7.3.7",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "monaco-editor": {
      "dompurify": "$dompurify"
    },
    "mermaid": {
      "katex": "$katex"
    }
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "fsevents": false
  }
}
