{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",

    /* 应用侧只使用浏览器环境类型；Node 类型仅由 tsconfig.node.json 提供给 vite.config.ts，
       否则 @types/node 会把 window.setTimeout 解析成 NodeJS.Timeout */
    "types": [],

    /* marked-katex-extension 的 types 指向其源码 .ts，用本地声明替换以避免检查其源码 */
    "paths": {
      "marked-katex-extension": ["./src/types/marked-katex-extension.d.ts"],
      "@platform": ["./src/platform/web.tsx"],
      "@monaco-setup": ["./src/monaco/web.ts"]
    },

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src"],
  "references": [{ "path": "./tsconfig.node.json" }]
}

